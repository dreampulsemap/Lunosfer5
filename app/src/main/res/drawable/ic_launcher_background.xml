<?xml version="1.0" encoding="utf-8"?>
<!--
    Lunosfer app ikonu - background katmanı.
    Koyu, mistik radial gradient: merkeze doğru hafif viyola/mor
    parıltı, kenarlara doğru Void950 (uygulamanın ana koyu tonu).
    Faz 1'deki ProfileSummaryCard'da kullanılan aynı "glow" dili.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="81">
                <item android:color="#1A1030" android:offset="0.0" />
                <item android:color="#0A0714" android:offset="0.55" />
                <item android:color="#04060E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

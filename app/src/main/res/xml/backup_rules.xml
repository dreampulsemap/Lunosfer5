<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 ve altindaki cihazlar icin Auto Backup kurallari
  (API 31+ icin data_extraction_rules.xml gecerli; ayni gerekce orada).

  Supabase oturumu artik EncryptedSessionManager ile sifreli tutuluyor
  (bkz. data_extraction_rules.xml). sharedpref alani yine de savunma
  katmani olarak yedekten disarida birakiliyor.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
</full-backup-content>

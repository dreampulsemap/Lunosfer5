<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 ve altindaki cihazlar icin Auto Backup kurallari
  (API 31+ icin data_extraction_rules.xml gecerli; ayni gerekce orada).

  Supabase oturumu (access_token + refresh_token) SharedPreferences'ta duz
  metin tutuluyor; bu alan yedege dahil edilmemeli.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31 ve ustu) icin yedekleme/cihaz aktarimi kurallari.

  GUNCELLEME: Supabase oturumu artik EncryptedSessionManager ile ayri,
  sifreli bir SharedPreferences dosyasinda ("lunosfer_secure_session")
  tutuluyor; duz metin degil. EncryptedSharedPreferences zaten Android
  Keystore'a bagli oldugu icin farkli bir cihaza geri yuklendiginde
  cozulemez ve kullanilamaz. Yine de savunma katmani olarak tum
  "sharedpref" alani yedekten disarida birakiliyor — icindeki diger
  degerler yalnizca yeniden uretilebilir onbellek ve arayuz tercihleri
  oldugundan bunun bir maliyeti yok.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

# Imza anahtarlari — ASLA depoya girmemeli. my-upload-key.jks Google Play
# yukleme anahtari: sizarsa uygulamanin kimligi baskasi tarafindan
# kullanilabilir ve Play tarafinda geri alinmasi zahmetli. Dosyalar diskte
# kaliyor, sadece takip edilmiyor; baska bir makineye gecerken elle kopyala.
*.jks
*.keystore

# Modul build cikislari (kok /build zaten yukarida; app/build ayri tutuluyor)
build/

# Firebase yapilandirmasi: APK icinde zaten dagitiliyor ama proje kimligi ve
# API anahtarlarini icerdigi icin depo disinda tutuluyor — yeni bir klonda
# Firebase konsolundan yeniden indirmek gerekir (yoksa build sadece uyarir,
# bkz. app/build.gradle.kts -> missingGoogleServicesStrategy = WARN).
app/google-services.json

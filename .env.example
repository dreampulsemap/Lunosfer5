# Bu dosya .env'in SABLONUDUR ve depoya girer; gercek degerler .env'de
# (gitignore'lu) tutulur. Secrets Gradle plugin .env yoksa buradaki degerleri
# kullanir (bkz. app/build.gradle.kts -> secrets { defaultPropertiesFileName }).
#
# DIKKAT: degerler BuildConfig.java icine oldugu gibi gomulur. Bos birakilan
# bir anahtar `String SUPABASE_ANON_KEY = ;` gibi GECERSIZ Java uretip temiz
# bir klonda derlemeyi kiriyordu - bu yuzden her anahtarin yer tutucu bir
# degeri olmali.
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_URL=https://placeholder.supabase.co
APP_URL=https://www.lunosfer.com/
